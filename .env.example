# Copiar para .env e preencher.  chmod 600.  NUNCA commitar.
# Se algum valor tiver caracteres especiais, use aspas simples: SENHA='a b#c'

# --- credenciais da conta weoInvoice ---------------------------------------
WEOINVOICE_EMAIL=
WEOINVOICE_PASSWORD=

# --- chave que os clientes mandam em X-Api-Key ------------------------------
# gerar com: openssl rand -hex 24
WEOINVOICE_API_KEY=

# --- servico ----------------------------------------------------------------
PORT=8007

# Id interno do cliente usado em vendas de balcao (tipicamente o registo
# "INDIFERENCIADO"). Descubra o seu em GET /catalogo. Sem isto, todo pedido
# precisa mandar clienteId explicitamente.
WEO_CLIENTE_PADRAO=

# --- TRAVA DE SEGURANCA -----------------------------------------------------
# O parser do carrinho precisa ser confirmado contra o DOM real antes de
# permitir emissao. Com 0 (ou ausente), dryRun funciona e a emissao real e
# recusada com HTTP 503. Rode `bun run probe.ts --dump`, confira, e so entao
# mude para 1.
WEO_CART_READ_VERIFIED=0

# --- notificacoes (opcional) ------------------------------------------------
# Sem chave, o servico simplesmente nao notifica.
GOSSIP_URL=
GOSSIP_API_KEY=
